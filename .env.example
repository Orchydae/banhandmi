# =============================================================
# Neon-managed — do not fill these in by hand.
# `neon link` / `neon checkout` write them via `neon env pull`.
# =============================================================
NEON_BRANCH=
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Object storage, provisioned on the branch but not used by the app yet.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# =============================================================
# banhapi Neon Function — read at deploy time by neon.ts
# =============================================================
# Browser origins allowed to call the API, comma-separated.
# Include the Vercel production domain and any preview domains.
ALLOWED_ORIGINS=http://localhost:5173

# Where Stripe returns the donor after checkout, used when the caller's
# Origin is not on the allowlist above.
APP_BASE_URL=http://localhost:5173

STRIPE_SECRET_KEY=
# Stripe dashboard -> the webhook endpoint pointing at the function.
STRIPE_WEBHOOK_SECRET=

# =============================================================
# Frontend (Vite) — must also be set in the Vercel project
# =============================================================
# Invocation URL of the deployed function: `neon functions get banhapi`
VITE_API_BASE_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
